VITAMINE_CLOUD_DB=/var/lib/vitamine-cloud/vitamine-cloud.sqlite
VITAMINE_DATABASE_URL=postgresql://vitamine_app:replace-with-a-random-password@127.0.0.1:5432/vitamine
VITAMINE_CLOUD_PEPPER=replace-with-a-random-secret
VITAMINE_DATA_ENCRYPTION_KEY=replace-with-urlsafe-base64-encoded-32-byte-key
VITAMINE_DATA_ENCRYPTION_PREVIOUS_KEYS=
VITAMINE_SESSION_ROOT=/run/vitamine-cloud/sessions
VITAMINE_JOB_ROOT=/var/lib/vitamine-cloud/jobs
VITAMINE_JOB_WORK_ROOT=/run/vitamine-cloud/jobs
ORCID_OAUTH_CLIENT_ID=APP-REPLACE-ME
ORCID_OAUTH_CLIENT_SECRET=replace-with-the-orcid-client-secret
ORCID_OAUTH_BASE_URL=https://orcid.org
ORCID_OAUTH_REDIRECT_URI=https://vitamine.cloud/gateway/orcid/oauth/callback
ZOTERO_OAUTH_CLIENT_KEY=replace-with-the-zotero-client-key
ZOTERO_OAUTH_CLIENT_SECRET=replace-with-the-zotero-client-secret
ZOTERO_OAUTH_CALLBACK_URL=https://vitamine.cloud/gateway/zotero/oauth/callback
VITAMINE_PUBLIC_URL=https://vitamine.cloud
VITAMINE_SMTP_HOST=smtp.strato.de
VITAMINE_SMTP_PORT=465
VITAMINE_SMTP_USERNAME=hello@vitamine.cloud
VITAMINE_SMTP_PASSWORD=replace-with-the-mailbox-or-app-password
VITAMINE_SMTP_FROM=hello@vitamine.cloud
VITAMINE_SMTP_USE_TLS=true
VITAMINE_IMAP_HOST=imap.strato.de
VITAMINE_IMAP_PORT=993
VITAMINE_MAIL_RETENTION_DAYS=30
